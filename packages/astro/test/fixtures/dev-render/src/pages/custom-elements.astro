---
const selectedColor = "blue";
const autoplay = 2000;
---
<html>
	<head><title>Custom Element Attributes Test</title></head>
	<body>
		<color-picker selected={selectedColor}></color-picker>
		<test-a autoplay={autoplay}>Test with autoplay prop working</test-a>
		<el-popover id="custom-popover" popover>Custom popover content</el-popover>
		<el-popover id="custom-popover-auto" popover="auto">Custom popover auto</el-popover>
		<my-element id="custom-hidden" hidden>Custom hidden</my-element>
	</body>
</html>
